
Options -Indexes -MultiViews +FollowSymLinks
ServerSignature Off
DirectoryIndex pages/home.php
ErrorDocument 404 /AIT/errors/404.php
ErrorDocument 403 /AIT/errors/404.php

<FilesMatch "^\.|\.(env|ini|log|md|sql|bak|old|orig|swp|sh|ps1|lock|yml|yaml|dist|phar|sqlite|json)$|^(composer|package)(-lock)?\.json$|^Dockerfile$">
    Require all denied
</FilesMatch>
<FilesMatch "^(llms\.txt|llms-full\.txt|site\.webmanifest)$">
    Require all granted
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
    Header set Cross-Origin-Opener-Policy "same-origin"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"
    Header always unset X-Powered-By
    Header unset X-Powered-By

    <FilesMatch "\.(css|js|webp|png|jpe?g|gif|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set Cross-Origin-Resource-Policy "same-origin"
    </FilesMatch>
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-cache"
        Header set Service-Worker-Allowed "/AIT/"
    </FilesMatch>
    <FilesMatch "\.(txt|webmanifest)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /AIT/

    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|DEBUG|CONNECT|PUT|DELETE|PATCH)$ [NC]
    RewriteRule ^ - [F]
    RewriteCond %{QUERY_STRING} (\<|%3C).*script.*(\>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} (\.\./|%2e%2e%2f|%2e%2e/|\.\.%2f) [NC,OR]
    RewriteCond %{QUERY_STRING} (union.*select|concat\(|information_schema) [NC]
    RewriteRule ^ - [F]

    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{THE_REQUEST} \s/AIT/(home|pages/home\.php)/?[\s?] [NC]
    RewriteRule ^ /AIT/ [R=301,L]

    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{THE_REQUEST} \s/AIT/(?:pages/)?(about|contact|programs|faq|admissions|campus-life|privacy-policy|terms-of-service|departments|alumini|students|faculty|career)\.php[\s?] [NC]
    RewriteRule ^ /AIT/%1 [R=301,L,NE]
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{THE_REQUEST} \s/AIT/(?:student/)?(dashboard|student-dashboard|student-login|log-in|registration)\.php[\s?] [NC]
    RewriteRule ^ /AIT/%1 [R=301,L,NE]

    RewriteRule ^$ pages/home.php [L,QSA]
    RewriteRule ^sitemap\.xml$ pages/sitemap.php [L]
    RewriteRule ^robots\.txt$ pages/robots.php [L]
    RewriteRule ^404/?$ errors/404.php [L,QSA]

    RewriteRule ^(about|contact|programs|faq|admissions|campus-life|privacy-policy|terms-of-service|departments|alumini|students|faculty|career)/?$ pages/$1.php [L,QSA]
    RewriteRule ^alumni/?$ /AIT/alumini [R=301,L]

    RewriteRule ^(login|log-in)/?$ student/log-in.php [L,QSA]
    RewriteRule ^student-login/?$ student/student-login.php [L,QSA]
    RewriteRule ^logout/?$ student/logout.php [L,QSA]
    RewriteRule ^(registration|register)/?$ student/registration.php [L,QSA]
    RewriteRule ^dashboard/?$ student/dashboard.php [L,QSA]
    RewriteRule ^student-dashboard/?$ student/student-dashboard.php [L,QSA]

    RewriteRule ^(generate_challan|generate_semester_challan|generate_slip|upload_challan|upload_semester_challan|submit_application|download_file|logout)\.php$ student/$1.php [L,QSA]

    RewriteRule ^teachers/(T[0-9]{5})/?$ teachers/profile.php?code=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ errors/404.php [L]
</IfModule>

<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag expose_php Off
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS;DEFLATE text/plain text/html text/css text/xml text/javascript application/javascript application/json application/ld+json application/xml application/manifest+json image/svg+xml
</IfModule>
<IfModule !mod_brotli.c>
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/plain text/html text/css text/xml text/javascript application/javascript application/json application/ld+json application/xml application/manifest+json image/svg+xml
    </IfModule>
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/webp .webp
    AddType font/woff2 .woff2
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 10 minutes"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>
