# Uploaded files are never served directly. They are streamed by
# student/download_file.php after an ownership check. In production set
# UPLOAD_ROOT to a directory outside the web root; this file is the fallback guard.
Require all denied
Options -Indexes -ExecCGI
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .phar .php3 .php4 .php5 .php7 .php8 .pht .cgi .pl .py .sh
RemoveType .php .phtml .phar
